{
  "name": "calculation-of-expenses",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write src tests scripts docs *.json *.ts index.html README.md",
    "format:check": "prettier --check src tests scripts docs *.json *.ts index.html README.md",
    "check": "npm run typecheck && npm run check:architecture && npm test && npm run format:check"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
